<% layout("/layouts/boilerplate") %>
<%- include("../includes/categories") %>

<div class="listings-page">
    <div class="listings-header">
        <div class="listings-header-top">
            <h1>Explore Homes</h1>
            <% if (totalResults > 0) { %>
                <span class="results-count">
                    <%= totalResults %> <%= totalResults === 1 ? 'property' : 'properties' %> found
                </span>
            <% } %>
        </div>
        <div class="listings-header-controls">
            <label for="sortSelect" class="sr-only">Sort listings</label>
            <select id="sortSelect" class="sort-select" onchange="handleSortChange()" aria-label="Sort listings">
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Top Rated</option>
            </select>
        </div>
    </div>

    <% if (allListings.length > 0) { %>
        <div class="listings-container">
            
            <% for (const listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-card">
                    <div class="listing-image-wrapper">
                        <img 
                            src="<%= listing.image.url %>" 
                            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1773062177647-76cf543b1795?q=80&w=1470&auto=format&fit=crop';" 
                            class="listing-image" 
                            alt="<%= listing.title %>"
                        >
                        <div class="image-overlay"></div>
                        
                        <% if (listing.reviews && listing.reviews.length > 0) { %>
                            <div class="listing-badge">
                                <i class="fas fa-star" style="color: #ffb500; margin-right: 4px;"></i>
                                <span style="font-weight: 700;"><%= (listing.reviews.reduce((sum, r) => sum + r.rating, 0) / listing.reviews.length).toFixed(2) %></span>
                            </div>
                        <% } %>
                        
                        <button class="save-btn wishlist-btn add-remove-wishlist <%= listing.isWishlisted ? 'active' : '' %>" data-id="<%= listing._id %>">
                            <i class="far fa-heart <%= listing.isWishlisted ? 'fa-solid text-danger' : 'fa-regular' %>" style="font-size: 1.2rem; color: #222222;"></i>
                        </button>
                    </div>

                    <div class="listing-info">
                        <h3 class="listing-title"><%= listing.title %></h3>
                        
                        <p class="listing-location">
                            <i class="fas fa-map-marker-alt" style="color: #fe424d; margin-right: 0.5rem;"></i>
                            <%= listing.location %>
                        </p>

                        <div class="listing-footer">
                            <div class="listing-rating">
                                <% if (listing.reviews && listing.reviews.length > 0) { %>
                                    <i class="fas fa-star star"></i>
                                    <span style="margin-left: 0.25rem;">(<span class="review-count"><%= listing.reviews.length %></span>)</span>
                                <% } else { %>
                                    <span style="color: #717171; font-size: 0.875rem;">New</span>
                                <% } %>
                            </div>
                            <div class="listing-price">
                                &#8377; <strong><%= listing.price.toLocaleString("en-IN") %></strong>
                                <div class="price-label">/ night</div>
                            </div>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>

        <% if (totalPages > 1) { %>
            <nav class="pagination-wrapper" aria-label="Listings pagination">
                <ul class="pagination">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/listings?<%= paginationQuery(currentPage - 1) %>" aria-label="Previous">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link pagination-number" href="/listings?<%= paginationQuery(i) %>"><%= i %></a>
                        </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/listings?<%= paginationQuery(currentPage + 1) %>" aria-label="Next">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        <% } %>
    <% } else { %>
        <div class="no-listings">
            <i class="fas fa-search" style="font-size: 2.5rem; color: #e0e0e0; margin-bottom: 1rem;"></i>
            <h2>No listings found</h2>
            <% if (search) { %>
                <p>No results for "<strong><%= search %></strong>". Try a different search term or category.</p>
            <% } else { %>
                <p>Check back soon for amazing homes!</p>
            <% } %>
            <a href="/listings" class="no-listings-btn">View all listings</a>
        </div>
    <% } %>
</div>

<script>
    function handleSortChange() {
        const sort = document.getElementById("sortSelect").value;
        const params = new URLSearchParams(window.location.search);
        params.set("sort", sort);
        params.delete("page");
        window.location.href = "/listings?" + params.toString();
    }
</script>
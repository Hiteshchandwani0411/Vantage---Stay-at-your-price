<% layout("/layouts/boilerplate") %>

<section class="landing-page">
  <div class="container">
    <div class="landing-hero">
      <div class="hero-copy">
        <span class="eyebrow"><i class="fa-solid fa-bolt" style="font-size: 0.75rem;"></i> Smart stays</span>
        <h1>Find a place that fits your budget.</h1>
        <p>
          Vantage helps travelers discover stays and deals that match their desired price — so you can compare, filter, and book with confidence without overspending.
        </p>

        <div class="hero-actions">
          <a href="/listings" class="btn red-btn">Explore stays</a>
          <a href="/signup" class="btn btn-outline-dark">Create account</a>
        </div>

        <div class="trust-row" aria-label="Key Vantage stats">
          <div class="trust-item">
            <strong>20k+</strong>
            <span>Price alerts</span>
          </div>
          <div class="trust-item">
            <strong>4.9/5</strong>
            <span>Guest rating</span>
          </div>
          <div class="trust-item">
            <strong>1 min</strong>
            <span>To browse</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-label="Featured property preview">
        <div class="image-stack">
          <img
            class="hero-main-image"
            src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80"
            alt="A modern luxury villa exterior"
          />
          <div class="floating-card price-highlight">From ₹4,200 / night</div>
          <div class="floating-card mini-card"><i class="fas fa-star" style="color: #ffb500;"></i> 4.9 guest rating</div>
        </div>
      </div>
    </div>

    <section class="landing-section" aria-labelledby="value-heading">
      <div class="section-head">
        <span class="eyebrow">Why Vantage</span>
        <h2 id="value-heading">The smarter way to book your next stay.</h2>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon"><i class="fas fa-wallet"></i></div>
          <h3>Price-first search</h3>
          <p>Browse homes that align with your target budget so you can skip the guesswork.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon"><i class="fas fa-filter"></i></div>
          <h3>Curated discovery</h3>
          <p>Find listings by style, location, and vibe without losing time in endless scrolling.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon"><i class="fas fa-bell"></i></div>
          <h3>Stay on track</h3>
          <p>Keep an eye on the properties you love and move when the right price appears.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
          <h3>Trusted stays</h3>
          <p>Explore verified listings, guest feedback, and polished property details before booking.</p>
        </article>
      </div>
    </section>

    <section class="landing-section" aria-labelledby="steps-heading">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 id="steps-heading">Three easy steps to your ideal stay.</h2>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <div class="step-number">1</div>
          <h3>Find a listing</h3>
          <p>Browse the featured stays and trending destinations to discover options that match your taste.</p>
        </article>

        <article class="step-card">
          <div class="step-number">2</div>
          <h3>Set your budget</h3>
          <p>Use Vantage to focus on homes that fit your preferred price range while comparing value.</p>
        </article>

        <article class="step-card">
          <div class="step-number">3</div>
          <h3>Book when it clicks</h3>
          <p>Move fast on the stay you want and secure the best deal when your preferred price is available.</p>
        </article>
      </div>
    </section>

    <section class="landing-section" aria-labelledby="showcase-heading">
      <div class="section-head">
        <span class="eyebrow">Popular picks</span>
        <h2 id="showcase-heading">Stay inspired by what’s trending right now.</h2>
      </div>

      <div class="showcase-grid">
        <article class="showcase-card">
          <div class="showcase-image">
            <img src="https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=900&q=80" alt="Clifftop villa" />
            <span class="showcase-tag">Scenic</span>
          </div>
          <div class="showcase-body">
            <div class="showcase-meta">
              <span>Coastal escape</span>
              <span><i class="fas fa-star" style="color: #ffb500; margin-right: 0.25rem;"></i>4.9</span>
            </div>
            <h3>Glasshouse Retreat</h3>
            <p>Private terrace, sunset views, and a warm luxury feel for weekend escapes.</p>
            <div class="showcase-footer">
              <div>
                <strong>₹6,800</strong>
                <span> / night</span>
              </div>
              <a href="/listings" class="showcase-link" aria-label="Explore Glasshouse Retreat"><i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </article>

        <article class="showcase-card">
          <div class="showcase-image">
            <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=900&q=80" alt="Modern home interior" />
            <span class="showcase-tag">City living</span>
          </div>
          <div class="showcase-body">
            <div class="showcase-meta">
              <span>Minimal design</span>
              <span><i class="fas fa-star" style="color: #ffb500; margin-right: 0.25rem;"></i>4.8</span>
            </div>
            <h3>Northline Loft</h3>
            <p>Bright interiors, rooftop access, and a faster route to the city’s best spots.</p>
            <div class="showcase-footer">
              <div>
                <strong>₹4,900</strong>
                <span> / night</span>
              </div>
              <a href="/listings" class="showcase-link" aria-label="Explore Northline Loft"><i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </article>

        <article class="showcase-card">
          <div class="showcase-image">
            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=900&q=80" alt="Mountain villa" />
            <span class="showcase-tag">Weekend reset</span>
          </div>
          <div class="showcase-body">
            <div class="showcase-meta">
              <span>Mountain air</span>
              <span><i class="fas fa-star" style="color: #ffb500; margin-right: 0.25rem;"></i>5.0</span>
            </div>
            <h3>Hillside Haven</h3>
            <p>Warm wood textures, scenic trails, and an easy getaway for quiet weekends.</p>
            <div class="showcase-footer">
              <div>
                <strong>₹5,600</strong>
                <span> / night</span>
              </div>
              <a href="/listings" class="showcase-link" aria-label="Explore Hillside Haven"><i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="landing-cta" aria-label="Primary call to action">
      <div>
        <span class="eyebrow">Ready to begin?</span>
        <h2>Explore stays that fit your price and your plans.</h2>
      </div>

      <div class="cta-actions">
        <a href="/listings" class="btn red-btn">Browse listings</a>
        <a href="/listings/new" class="btn btn-outline-dark">List your property</a>
      </div>
    </section>
  </div>
</section>

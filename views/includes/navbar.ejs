<nav class="navbar navbar-expand-md bg-white sticky-top"
  aria-label="Primary navigation">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"
      aria-label="Vantage home">
      <i class="fa-regular fa-compass"></i>
      <span>Vantage</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-search-wrap flex-grow-1 mx-md-3">
        <form class="navbar-search" role="search" action="/listings" method="get">
          <div class="input-group">
            <span class="input-group-text">
              <i class="fas fa-search"></i>
            </span>
            <input
              class="form-control"
              type="search" 
              name="search"
              placeholder="Search by location..."
              aria-label="Search"
            />
          </div>
        </form>
      </div>

      <div class="navbar-nav navbar-links">
        <a class="nav-link nav-link-custom <%= (typeof page !== 'undefined' && page === 'explore') ? 'active-page' : '' %>"
          href="/listings" <%= (typeof page !== 'undefined' && page === 'explore') ? 'aria-current="page"' : '' %>>
          </i><span>Explore</span>
        </a>

        <% if (currUser) { %>
          <a class="nav-link nav-link-custom <%= (typeof page !== 'undefined' && page === 'wishlist') ? 'active-page' : '' %>"
            href="/user/wishlist" <%= (typeof page !== 'undefined' && page === 'wishlist') ? 'aria-current="page"' : '' %>>
            <i class="fas fa-heart"></i><span>Wishlist</span>
          </a>
        <% } %>

        <a class="nav-link nav-link-custom <%= (typeof page !== 'undefined' && page === 'host') ? 'active-page' : '' %>"
          href="/listings/new" <%= (typeof page !== 'undefined' && page === 'host') ? 'aria-current="page"' : '' %>>
          <i class="fas fa-plus"></i><span>Host</span>
        </a>
      </div>
      <div class="navbar-nav ms-auto">
        <% if (!currUser) { %>
          <a class="nav-link nav-link-custom <%= (typeof page !== 'undefined' && page === 'signup') ? 'active-page' : '' %>"
            href="/signup" <%= (typeof page !== 'undefined' && page === 'signup') ? 'aria-current="page"' : '' %>>
            Sign Up
          </a>

          <a class="nav-link nav-btn-login <%= (typeof page !== 'undefined' && page === 'login') ? 'active-page' : '' %>"
            href="/login" <%= (typeof page !== 'undefined' && page === 'login') ? 'aria-current="page"' : '' %>>
            <i class="fas fa-arrow-right-to-bracket"></i><span>Login</span>
          </a>
        <% } %>
        <% if (currUser) { %>
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle nav-user" href="#" role="button" data-bs-toggle="dropdown">
              <i class="fas fa-user-circle"></i>
              <%= currUser.username %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/listings/new">List a Property</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item text-danger" href="/logout">Logout</a></li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>